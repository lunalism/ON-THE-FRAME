@@ -0,0 +1,28 @@
+import Foundation
+import Darwin
+
+// PROPOSED ONLY. Not installed, compiled or executed by IMG-B-PERF-01.
+// Per-worker synchronous spans, no per-pixel clocks and no rendering expression refactor.
+final class IBPerfProbe {
+    static let enabled = ProcessInfo.processInfo.environment["OTF_IMG_B_PERF01_PROBE"] == "1"
+    private static func stamp() -> (UInt64,Double?) {
+        var info = thread_basic_info(), count = mach_msg_type_number_t(MemoryLayout<thread_basic_info>.size / 4)
+        let thread = pthread_mach_thread_np(pthread_self()) // borrowed thread port
+        let result = withUnsafeMutablePointer(to: &info) { pointer in
+            pointer.withMemoryRebound(to: integer_t.self,capacity: Int(count)) {
+                thread_info(thread,thread_flavor_t(THREAD_BASIC_INFO),$0,&count)
+            }
+        }
+        let cpu: Double? = result == KERN_SUCCESS ? Double(info.user_time.seconds + info.system_time.seconds)
+            + Double(info.user_time.microseconds + info.system_time.microseconds) / 1_000_000 : nil
+        return (DispatchTime.now().uptimeNanoseconds,cpu)
+    }
+    private var last = IBPerfProbe.stamp()
+    private(set) var rows: [[String:Any]] = []
+    func mark(_ label: String) {
+        let now = Self.stamp()
+        let cpu: Any = (last.1 != nil && now.1 != nil) ? max(0,now.1! - last.1!) as Any : "unavailable"
+        rows.append(["stage":label,"wallSeconds":Double(now.0 - last.0) / 1e9,"threadCPUSeconds":cpu])
+        last = now
+    }
+}
